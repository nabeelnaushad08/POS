generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

enum NotificationType {
  LOW_STOCK
  DAILY_SUMMARY
  SYSTEM
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  PARTIAL
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(CASHIER)
  phone        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sales        Sale[]
  purchases    Purchase[]
  activityLogs ActivityLog[]

  @@index([email])
  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  color       String?   @default("#6366f1")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]

  @@index([phone])
  @@map("customers")
}

model Product {
  id              String            @id @default(cuid())
  name            String
  sku             String            @unique
  barcode         String?           @unique
  description     String?
  categoryId      String?
  costPrice       Decimal           @db.Decimal(10, 2)
  sellingPrice    Decimal           @db.Decimal(10, 2)
  stock           Int               @default(0)
  minimumStock    Int               @default(5)
  unit            String            @default("pcs")
  image           String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  category        Category?         @relation(fields: [categoryId], references: [id])
  saleItems       SaleItem[]
  supplierProducts SupplierProduct[]
  purchaseItems   PurchaseItem[]

  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@map("products")
}

model Supplier {
  id            String            @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  products      SupplierProduct[]
  purchases     Purchase[]
  payments      SupplierPayment[]

  @@map("suppliers")
}

model SupplierProduct {
  id         String   @id @default(cuid())
  supplierId String
  productId  String
  createdAt  DateTime @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
  @@map("supplier_products")
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  userId         String
  subtotal       Decimal        @db.Decimal(10, 2)
  discount       Decimal        @default(0) @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  amountPaid     Decimal        @default(0) @db.Decimal(10, 2)
  status         PurchaseStatus @default(RECEIVED)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  items          PurchaseItem[]
  payments       SupplierPayment[]

  @@index([supplierId])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id           String   @id @default(cuid())
  purchaseId   String
  productId    String
  productName  String
  sku          String
  quantity     Int
  unitCost     Decimal  @db.Decimal(10, 2)
  subtotal     Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model SupplierPayment {
  id         String      @id @default(cuid())
  supplierId String
  purchaseId String?
  amount     Decimal     @db.Decimal(10, 2)
  method     PaymentMethod @default(CASH)
  notes      String?
  createdAt  DateTime    @default(now())

  supplier   Supplier    @relation(fields: [supplierId], references: [id])
  purchase   Purchase?   @relation(fields: [purchaseId], references: [id])

  @@index([supplierId])
  @@map("supplier_payments")
}

model Sale {
  id            String        @id @default(cuid())
  receiptNumber String        @unique
  userId        String
  customerId    String?
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  cashAmount    Decimal?      @db.Decimal(10, 2)
  cardAmount    Decimal?      @db.Decimal(10, 2)
  change        Decimal?      @db.Decimal(10, 2)
  status        SaleStatus    @default(COMPLETED)
  notes         String?
  customerName  String?
  customerPhone String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  items         SaleItem[]

  @@index([userId])
  @@index([customerId])
  @@index([createdAt])
  @@index([receiptNumber])
  @@map("sales")
}

model SaleItem {
  id          String    @id @default(cuid())
  saleId      String
  productId   String
  productName String
  sku         String
  quantity    Int
  costPrice   Decimal   @db.Decimal(10, 2)
  unitPrice   Decimal   @db.Decimal(10, 2)
  subtotal    Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Notification {
  id           String           @id @default(cuid())
  type         NotificationType
  title        String
  message      String           @db.Text
  isRead       Boolean          @default(false)
  sentEmail    Boolean          @default(false)
  sentWhatsApp Boolean          @default(false)
  metadata     String?          @db.Text
  createdAt    DateTime         @default(now())

  @@index([type])
  @@index([isRead])
  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model PrinterSettings {
  id          String   @id @default(cuid())
  type        String   @unique
  printerName String?
  paperSize   String   @default("80mm")
  headerTitle String?
  logo        String?  @db.LongText
  showLogo    Boolean  @default(false)
  footer      String?
  showFooter  Boolean  @default(true)
  copies      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("printer_settings")
}

model SystemSettings {
  id             String   @id @default(cuid())
  systemName     String   @default("POS System")
  logo           String?  @db.LongText
  currency       String   @default("LKR")
  currencySymbol String   @default("Rs.")
  timezone       String   @default("Asia/Colombo")
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  theme          String   @default("light")
  address        String?
  phone          String?
  email          String?
  kotEnabled     Boolean  @default(false)
  printerIp      String?
  printerEnabled Boolean  @default(false)
  slogan         String?
  whatsApp       String?
  receiptNote    String?
  thankYouLine1  String   @default("THANK YOU FOR YOUR VISIT")
  thankYouLine2  String   @default("COME AGAIN!")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("system_settings")
}

model Employee {
  id              String    @id @default(cuid())
  employeeId      String    @unique  // auto-generated: EMP-0001
  fullName        String
  nicNumber       String?   @unique
  dateOfBirth     DateTime?
  gender          String?   // MALE, FEMALE, OTHER
  contactNumber   String?
  email           String?
  address         String?
  emergencyContact String?
  dateJoined      DateTime  @default(now())
  position        String    @default("Cashier")
  department      String?
  basicSalary     Decimal   @default(0) @db.Decimal(10, 2)
  employmentType  String    @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, TEMPORARY
  photo           String?   @db.LongText
  isActive        Boolean   @default(true)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attendance      Attendance[]
  payroll         Payroll[]
  performanceNotes PerformanceNote[]

  @@index([isActive])
  @@map("employees")
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  date        DateTime  @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("PRESENT") // PRESENT, ABSENT, LATE, HALF_DAY
  notes       String?
  createdAt   DateTime  @default(now())

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("attendance")
}

model Payroll {
  id              String    @id @default(cuid())
  employeeId      String
  month           Int       // 1-12
  year            Int
  basicSalary     Decimal   @db.Decimal(10, 2)
  workingDays     Int       @default(0)
  presentDays     Int       @default(0)
  overtimeHours   Decimal   @default(0) @db.Decimal(6, 2)
  overtimeRate    Decimal   @default(0) @db.Decimal(10, 2)
  allowances      Decimal   @default(0) @db.Decimal(10, 2)
  deductions      Decimal   @default(0) @db.Decimal(10, 2)
  bonus           Decimal   @default(0) @db.Decimal(10, 2)
  advance         Decimal   @default(0) @db.Decimal(10, 2)
  netSalary       Decimal   @db.Decimal(10, 2)
  status          String    @default("PENDING") // PENDING, PAID
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
  @@map("payroll")
}

model PerformanceNote {
  id          String    @id @default(cuid())
  employeeId  String
  type        String    @default("NOTE") // NOTE, WARNING, COMMENDATION
  title       String
  description String    @db.Text
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("performance_notes")
}
