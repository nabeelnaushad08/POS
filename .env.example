# Database — Required
# MySQL (Hostinger, local, Railway):
DATABASE_URL="mysql://username:password@hostname:3306/database_name"
# Supabase PostgreSQL (change schema.prisma provider to postgresql first):
# DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"

# NextAuth — Required
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="https://yourdomain.com"

# Product License Master Password (for Zenthoz internal use only)
ZENTHOZ_MASTER_PASSWORD="zenthoz-admin-2024"

# Optional: Twilio for SMS/WhatsApp notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
